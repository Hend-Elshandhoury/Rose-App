# --- Backend API (profile, auth, etc.) ---
# Use the same origin your backend exposes (often includes /api/v1).
# Server actions prefer API_URL; profile.api.ts falls back to NEXT_PUBLIC_API_URL if API_URL is unset.
API_URL=https://example.com/api/v1
NEXT_PUBLIC_API_URL=https://example.com/api/v1

# Optional: force a single profile-update path (no leading slash). If unset, the app tries
# auth/editProfile, auth/edit-profile, user/profile, auth/profile with PUT then PATCH.
# API_EDIT_PROFILE_PATH=auth/editProfile

# Images (optional)
NEXT_PUBLIC_IMAGE_API_URL=https://example.com/uploads

# NextAuth (required)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
